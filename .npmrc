auto-install-peers=false
strict-peer-dependencies=false

# Flat (npm-style) install layout instead of pnpm's default isolated layout.
# Why: Vercel's @vercel/node function type-check runs a TS LanguageService
# whose module resolution does NOT resolve symlinks to real paths. With the
# isolated layout, the same package is reachable via two different symlink
# paths (e.g. drizzle-orm via the api-server's node_modules AND via
# @workspace/db's node_modules), producing two incompatible type identities
# (private fields like drizzle-orm's `shouldInlineParams`, and Express's
# @types chain) and TS2339/TS2345/TS2769 build failures that `tsc -p`
# never sees (it realpaths). Hoisting gives every package exactly one
# path, so the function check, `tsc -p`, esbuild and Vite all agree.
node-linker=hoisted
